# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Database Connection
DATABASE_URL="postgresql://xcloud_user:xcloud_secure_pass@localhost:5432/xcloud_db?schema=public"

# Redis Cache & BullMQ Queue Connection
REDIS_URL="redis://:redis_secure_pass@localhost:6379/0"

# JWT Authentication Secrets
JWT_SECRET="xcloud_jwt_access_secret_super_secure_key_min_32_bytes_2026"
JWT_REFRESH_SECRET="xcloud_jwt_refresh_secret_super_secure_key_min_32_bytes_2026"

# Credential Encryption at Rest (AES-256-GCM / Argon2id)
ENCRYPTION_KEY="xcloud_aes256_gcm_encryption_master_key_32_bytes_hex"

# FreeRADIUS Shared Secret for MikroTik RouterOS NAS
RADIUS_SECRET="xcloud_freeradius_shared_secret_mikrotik_nas_2026"
RADIUS_PORT="1812"
RADIUS_ACCT_PORT="1813"

# MikroTik REST API Client Configuration
MIKROTIK_API_TIMEOUT="10000"
MIKROTIK_DEFAULT_PORT="8728"
MIKROTIK_SSL_PORT="8729"

# Mobile Money & Payment Gateway Configurations (Tanzania & Global)
# Providers: Selcom, M-Pesa (Vodacom), Airtel Money, Tigo Pesa (Mixx), HaloPesa
PAYMENT_PROVIDER="SELCOM"
PAYMENT_PROVIDER_URL="https://api.selcompay.com/v1"
PAYMENT_API_KEY="SELCOM_LIVE_API_KEY"
PAYMENT_API_SECRET="SELCOM_LIVE_API_SECRET"
PAYMENT_WEBHOOK_SECRET="SELCOM_WEBHOOK_SIGNATURE_KEY"

# Notifications: SMS (Beem Africa / Twilio) & WhatsApp Gateway
SMS_PROVIDER="BEEM_AFRICA"
SMS_API_KEY="BEEM_AFRICA_KEY"
SMS_API_SECRET="BEEM_AFRICA_SECRET"
SMS_SENDER_ID="XCLOUD_NET"
WHATSAPP_API_KEY="WHATSAPP_BUSINESS_GATEWAY_KEY"

# Server Execution Port
PORT=3000
NODE_ENV="development"

