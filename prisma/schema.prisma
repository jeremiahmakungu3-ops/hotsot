// XCLOUD.NET — Production Multi-Tenant Hotspot & ISP Billing Database Schema
// Database: PostgreSQL with Prisma ORM

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  SUPER_ADMIN
  ISP_OWNER
  ADMINISTRATOR
  NETWORK_ENGINEER
  BILLING_MANAGER
  AGENT
  POS_OPERATOR
  SUPPORT_STAFF
  CUSTOMER
}

enum RouterStatus {
  ONLINE
  OFFLINE
  DEGRADED
  PROVISIONING
}

enum ConnectionMethod {
  REST_API
  WINBOX_API
  WIREGUARD
  DIRECT_IP
}

enum VoucherStatus {
  GENERATED
  UNUSED
  REDEEMED
  ACTIVE
  EXPIRED
  REVOKED
}

enum PaymentStatus {
  INITIATED
  PENDING
  CALLBACK_RECEIVED
  VERIFIED
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethodType {
  MPESA
  AIRTEL_MONEY
  TIGO_PESA
  HALOPESA
  SELCOM
  CASH_POS
  BANK_TRANSFER
  CREDIT_CARD
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
  PAST_DUE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum PackageType {
  HOTSPOT_TIME
  HOTSPOT_DATA
  HOTSPOT_UNLIMITED
  PPPOE_MONTHLY
  BANDWIDTH_BURST
}

// -------------------------------------------------------------
// Multi-Tenant Core Models
// -------------------------------------------------------------

model Tenant {
  id              String         @id @default(uuid())
  name            String         @db.VarChar(255)
  slug            String         @unique @db.VarChar(100)
  contactEmail    String         @db.VarChar(255)
  contactPhone    String         @db.VarChar(50)
  country         String         @default("Tanzania") @db.VarChar(100)
  currency        String         @default("TZS") @db.VarChar(10)
  logoUrl         String?        @db.Text
  address         String?        @db.Text
  isActive        Boolean        @default(true)
  settings        Json?          // Custom branding, portal options, SMS sender IDs
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  users           User[]
  routers         Router[]
  packages        Package[]
  vouchers        Voucher[]
  voucherBatches  VoucherBatch[]
  customers       Customer[]
  payments        Payment[]
  transactions    Transaction[]
  agents          Agent[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  hotspotSessions HotspotSession[]
  radiusUsers     RadiusUser[]
  auditLogs       AuditLog[]
  apiKeys         ApiKey[]

  @@index([slug])
  @@index([isActive])
}

model User {
  id                String       @id @default(uuid())
  tenantId          String?
  tenant            Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email             String       @unique @db.VarChar(255)
  username          String       @unique @db.VarChar(100)
  passwordHash      String       @db.VarChar(255)
  fullName          String       @db.VarChar(255)
  phoneNumber       String?      @db.VarChar(50)
  role              RoleType     @default(ISP_OWNER)
  isEmailVerified   Boolean      @default(false)
  isTwoFactorActive Boolean      @default(false)
  twoFactorSecret   String?      @db.VarChar(255)
  isActive          Boolean      @default(true)
  lastLoginAt       DateTime?
  lastLoginIp       String?      @db.VarChar(50)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  auditLogs         AuditLog[]
  agentProfile      Agent?
  customerProfile   Customer?

  @@index([tenantId])
  @@index([email])
  @@index([username])
}

// -------------------------------------------------------------
// MikroTik Router Management & Monitoring
// -------------------------------------------------------------

model Router {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String           @db.VarChar(255)
  identity         String?          @db.VarChar(255)
  model            String?          @db.VarChar(100)
  routerOsVersion  String?          @db.VarChar(50)
  ipAddress        String           @db.VarChar(100)
  publicIp         String?          @db.VarChar(100)
  apiPort          Int              @default(8728)
  restPort         Int              @default(443)
  location         String?          @db.VarChar(255)
  connectionMethod ConnectionMethod @default(REST_API)
  enrollmentToken  String           @unique @db.VarChar(255)
  isEnrolled       Boolean          @default(false)
  status           RouterStatus     @default(OFFLINE)
  cpuUsage         Int              @default(0)
  memoryUsage      Int              @default(0)
  uptimeSeconds    BigInt           @default(0)
  activeUsersCount Int              @default(0)
  lastHeartbeatAt  DateTime?
  wireguardIp      String?          @db.VarChar(100)
  radiusSecret     String           @db.VarChar(255)
  isRadiusEnabled  Boolean          @default(true)
  isHotspotEnabled Boolean          @default(true)
  isPppoeEnabled   Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  credentials      RouterCredential?
  heartbeats       RouterHeartbeat[]
  interfaces       RouterInterface[]
  hotspotSessions  HotspotSession[]
  vouchers         Voucher[]

  @@index([tenantId])
  @@index([status])
  @@index([enrollmentToken])
}

model RouterCredential {
  id               String   @id @default(uuid())
  routerId         String   @unique
  router           Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  apiUsername      String   @db.VarChar(100)
  encryptedPassword String  @db.Text
  wireguardPubKey  String?  @db.Text
  wireguardPrivKey String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RouterHeartbeat {
  id          String   @id @default(uuid())
  routerId    String
  router      Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  cpu         Int
  ram         Int
  freeHdd     BigInt?
  uptime      BigInt
  activeUsers Int      @default(0)
  trafficIn   BigInt   @default(0)
  trafficOut  BigInt   @default(0)
  wanStatus   String?  @db.VarChar(50)
  vpnStatus   String?  @db.VarChar(50)
  recordedAt  DateTime @default(now())

  @@index([routerId, recordedAt])
}

model RouterInterface {
  id           String   @id @default(uuid())
  routerId     String
  router       Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)
  name         String   @db.VarChar(100)
  type         String   @db.VarChar(50)
  macAddress   String?  @db.VarChar(50)
  rxBytes      BigInt   @default(0)
  txBytes      BigInt   @default(0)
  rxPackets    BigInt   @default(0)
  txPackets    BigInt   @default(0)
  rxErrors     Int      @default(0)
  txErrors     Int      @default(0)
  isUp         Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@index([routerId])
}

// -------------------------------------------------------------
// Packages, Vouchers & HotSpot Engine
// -------------------------------------------------------------

model Package {
  id                   String        @id @default(uuid())
  tenantId             String
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String        @db.VarChar(255)
  type                 PackageType   @default(HOTSPOT_TIME)
  price                Decimal       @db.Decimal(12, 2)
  currency             String        @default("TZS") @db.VarChar(10)
  durationSeconds      Int           // Duration in seconds (e.g., 3600 for 1h, 86400 for 24h)
  validityDays         Int           @default(30) // Expiration from purchase
  uploadSpeedKbps      Int           @default(5120) // 5 Mbps
  downloadSpeedKbps    Int           @default(10240) // 10 Mbps
  dataLimitBytes       BigInt?       // null for unlimited
  simultaneousSessions Int           @default(1)
  mikrotikRateLimit    String        @default("5M/10M") @db.VarChar(50)
  mikrotikAddressPool  String?       @db.VarChar(100)
  mikrotikProfileName  String?       @db.VarChar(100)
  description          String?       @db.Text
  isActive             Boolean       @default(true)
  isFeatured           Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  vouchers             Voucher[]
  payments             Payment[]
  subscriptions        Subscription[]
  invoices             Invoice[]

  @@index([tenantId])
  @@index([isActive])
}

model VoucherBatch {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batchNumber  String    @unique @db.VarChar(100)
  packageId    String
  quantity     Int
  usedCount    Int       @default(0)
  prefix       String?   @db.VarChar(20)
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())

  vouchers     Voucher[]

  @@index([tenantId])
  @@index([batchNumber])
}

model Voucher {
  id                 String        @id @default(uuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batchId            String?
  batch              VoucherBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  packageId          String
  package            Package       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  routerId           String?
  router             Router?       @relation(fields: [routerId], references: [id], onDelete: SetNull)
  agentId            String?
  agent              Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  code               String        @unique @db.VarChar(50) // The username or code
  pin                String?       @db.VarChar(50) // Optional PIN
  qrCodeData         String?       @db.Text
  status             VoucherStatus @default(GENERATED)
  activatedAt        DateTime?
  expiresAt          DateTime?
  usedBytes          BigInt        @default(0)
  usedSeconds        Int           @default(0)
  redeemedByCustomer String?       @db.VarChar(255)
  redeemedMacAddress String?       @db.VarChar(50)
  redeemedIpAddress  String?       @db.VarChar(50)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  hotspotSessions    HotspotSession[]

  @@index([tenantId])
  @@index([code])
  @@index([status])
  @@index([packageId])
}

// -------------------------------------------------------------
// Customers & RADIUS Session Accounting
// -------------------------------------------------------------

model Customer {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?          @unique
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName       String           @db.VarChar(255)
  phoneNumber    String           @db.VarChar(50)
  email          String?          @db.VarChar(255)
  address        String?          @db.Text
  accountNumber  String           @unique @db.VarChar(50)
  pppoeUsername  String?          @unique @db.VarChar(100)
  pppoePassword  String?          @db.VarChar(255)
  staticIp       String?          @db.VarChar(50)
  balance        Decimal          @default(0.00) @db.Decimal(12, 2)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  devices        CustomerDevice[]
  payments       Payment[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  sessions       HotspotSession[]
  radiusSessions RadiusSession[]

  @@index([tenantId])
  @@index([accountNumber])
  @@index([phoneNumber])
}

model CustomerDevice {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  macAddress  String    @db.VarChar(50)
  deviceName  String?   @db.VarChar(100)
  lastIp      String?   @db.VarChar(50)
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([customerId, macAddress])
  @@index([macAddress])
}

model HotspotSession {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routerId         String
  router           Router    @relation(fields: [routerId], references: [id], onDelete: Cascade)
  voucherId        String?
  voucher          Voucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  username         String    @db.VarChar(100)
  ipAddress        String    @db.VarChar(50)
  macAddress       String    @db.VarChar(50)
  startedAt        DateTime  @default(now())
  stoppedAt        DateTime?
  durationSeconds  Int       @default(0)
  bytesIn          BigInt    @default(0)
  bytesOut         BigInt    @default(0)
  terminateCause   String?   @db.VarChar(100)
  isActive         Boolean   @default(true)
  rateLimitApplied String?   @db.VarChar(50)

  @@index([tenantId])
  @@index([routerId])
  @@index([username])
  @@index([isActive])
}

// -------------------------------------------------------------
// FreeRADIUS Schema Standard Models
// -------------------------------------------------------------

model RadiusUser {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username  String   @unique @db.VarChar(100)
  attribute String   @default("Cleartext-Password") @db.VarChar(100)
  op        String   @default(":=") @db.VarChar(5)
  value     String   @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([username])
}

model RadiusSession {
  id              String    @id @default(uuid())
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  username        String    @db.VarChar(100)
  nasIpAddress    String    @db.VarChar(50)
  nasPortId       String?   @db.VarChar(50)
  acctSessionId   String    @unique @db.VarChar(100)
  acctUniqueId    String    @unique @db.VarChar(100)
  framedIpAddress String?   @db.VarChar(50)
  callingStationId String?  @db.VarChar(50) // MAC address
  acctStartTime   DateTime  @default(now())
  acctStopTime    DateTime?
  acctSessionTime Int       @default(0)
  acctInputOctets BigInt    @default(0)
  acctOutputOctets BigInt   @default(0)
  acctTerminateCause String? @db.VarChar(50)

  @@index([username])
  @@index([acctSessionId])
}

// -------------------------------------------------------------
// Mobile Money, Payments & Invoicing
// -------------------------------------------------------------

model Payment {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  packageId        String?
  package          Package?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  agentId          String?
  agent            Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  paymentReference String            @unique @db.VarChar(100) // e.g. XCL-TZS-89218
  providerTxId     String?           @db.VarChar(100) // M-Pesa / Selcom Transaction ID
  method           PaymentMethodType @default(MPESA)
  amount           Decimal           @db.Decimal(12, 2)
  currency         String            @default("TZS") @db.VarChar(10)
  phoneNumber      String            @db.VarChar(50)
  status           PaymentStatus     @default(INITIATED)
  rawCallbackData  Json?
  verifiedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  transaction      Transaction?
  invoice          Invoice?

  @@index([tenantId])
  @@index([paymentReference])
  @@index([providerTxId])
  @@index([status])
}

model Transaction {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type        String   @db.VarChar(50) // HOTSPOT_PURCHASE, PPPOE_RENEWAL, POS_FLOAT, COMMISSION
  amount      Decimal  @db.Decimal(12, 2)
  fee         Decimal  @default(0.00) @db.Decimal(12, 2)
  netAmount   Decimal  @db.Decimal(12, 2)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// Agent & POS Float System
// -------------------------------------------------------------

model Agent {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentCode      String         @unique @db.VarChar(50)
  commissionRate Decimal        @default(5.00) @db.Decimal(5, 2) // e.g., 5%
  walletBalance  Decimal        @default(0.00) @db.Decimal(12, 2)
  totalSales     Decimal        @default(0.00) @db.Decimal(12, 2)
  totalCommission Decimal       @default(0.00) @db.Decimal(12, 2)
  location       String?        @db.VarChar(255)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  vouchers       Voucher[]
  payments       Payment[]
  commissions    AgentCommission[]

  @@index([tenantId])
  @@index([agentCode])
}

model AgentCommission {
  id        String   @id @default(uuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  rate      Decimal  @db.Decimal(5, 2)
  saleAmount Decimal @db.Decimal(12, 2)
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([agentId])
}

// -------------------------------------------------------------
// Subscriptions & Invoicing
// -------------------------------------------------------------

model Subscription {
  id             String             @id @default(uuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  packageId      String
  package        Package            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  billingCycle   String             @default("MONTHLY") @db.VarChar(50)
  price          Decimal            @db.Decimal(12, 2)
  startDate      DateTime           @default(now())
  nextBillingDate DateTime
  status         SubscriptionStatus @default(ACTIVE)
  autoRenew      Boolean            @default(true)
  paymentMethod  PaymentMethodType  @default(MPESA)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([status])
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  packageId      String?
  package        Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  paymentId      String?       @unique
  payment        Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoiceNumber  String        @unique @db.VarChar(50)
  amount         Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(ISSUED)
  dueDate        DateTime
  paidAt         DateTime?
  itemsJson      Json?
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId])
  @@index([invoiceNumber])
  @@index([status])
}

// -------------------------------------------------------------
// Observability, Audit Logging & API Integrations
// -------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @db.VarChar(100)
  ipAddress  String?  @db.VarChar(50)
  userAgent  String?  @db.Text
  details    Json?
  result     String   @default("SUCCESS") @db.VarChar(50)
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyName    String    @db.VarChar(100)
  keyHash    String    @unique @db.VarChar(255)
  prefix     String    @db.VarChar(20)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([keyHash])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt
}
